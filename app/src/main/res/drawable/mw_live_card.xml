<?xml version="1.0" encoding="utf-8"?>
<!-- Dark glass card like the reference: soft vertical sheen + hairline rim -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="270" android:startColor="#FF3A3C38" android:centerColor="#FF2A2C29" android:endColor="#FF1E1F1D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
