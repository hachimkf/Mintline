<?xml version="1.0" encoding="utf-8"?>
<!-- Match centre widget, after the "Stamford Bridge · Week 10" live card reference -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/mw_live_card" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp">

    <!-- top bar: competition · venue + round · status -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/nm_league_logo" android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_crest_placeholder" />
            <TextView android:id="@+id/nm_league" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:maxLines="1" android:ellipsize="end"
                android:text="LaLiga" android:textSize="11sp" android:textColor="#FF9A9C97" android:fontFamily="@font/epilogue" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:id="@+id/nm_venue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:maxWidth="170dp"
                android:text="Stamford Bridge" android:textSize="14sp" android:textColor="#FFFFFFFF" android:fontFamily="@font/epilogue" />
            <TextView android:id="@+id/nm_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1"
                android:text="Week 10" android:textSize="10sp" android:textColor="#FF9A9C97" android:fontFamily="@font/epilogue" />
        </LinearLayout>
        <TextView android:id="@+id/nm_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:maxLines="1"
            android:text="Match" android:textSize="11sp" android:textColor="#FF9A9C97" android:fontFamily="@font/epilogue" />
    </LinearLayout>

    <!-- crests + big score -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <ImageView android:id="@+id/nm_home_logo" android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/ic_crest_placeholder" android:scaleType="fitCenter" />
            <TextView android:id="@+id/nm_home" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxLines="1" android:ellipsize="end"
                android:text="Real Madrid" android:textSize="13sp" android:textColor="#FFFFFFFF" android:fontFamily="@font/epilogue" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌂ Home" android:textSize="10sp" android:textColor="#FF9A9C97" android:fontFamily="@font/epilogue" />
        </LinearLayout>
        <TextView android:id="@+id/nm_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0 : 1" android:textSize="34sp" android:textColor="#FFFFFFFF" android:fontFamily="@font/epilogue" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <ImageView android:id="@+id/nm_away_logo" android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/ic_crest_placeholder" android:scaleType="fitCenter" />
            <TextView android:id="@+id/nm_away" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxLines="1" android:ellipsize="end"
                android:text="Barcelona" android:textSize="13sp" android:textColor="#FFFFFFFF" android:fontFamily="@font/epilogue" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Away" android:textSize="10sp" android:textColor="#FF9A9C97" android:fontFamily="@font/epilogue" />
        </LinearLayout>
    </LinearLayout>

    <!-- green pill: live minute, or countdown to kick-off -->
    <LinearLayout android:id="@+id/nm_countdown_box" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
        android:background="@drawable/mw_minute_pill" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="3dp" android:paddingBottom="3dp">
        <TextView android:id="@+id/nm_countdown_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▸ " android:textSize="11sp" android:textColor="#FF8BE04E" android:fontFamily="@font/epilogue" />
        <Chronometer android:id="@+id/nm_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#FF8BE04E" android:fontFamily="@font/epilogue" android:visibility="gone" />
        <TextView android:id="@+id/nm_countdown_days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="90 + 4" android:textSize="12sp" android:textColor="#FF8BE04E" android:fontFamily="@font/epilogue" />
    </LinearLayout>
</LinearLayout>
