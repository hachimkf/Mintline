<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/ln_card" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="6dp" android:paddingBottom="6dp">
    <FrameLayout android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/ln_crest_plate">
            <ImageView android:id="@+id/ln_home_logo" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="3dp" android:scaleType="fitCenter" />
        </FrameLayout>
    <TextView android:id="@+id/ln_home" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:maxLines="1" android:ellipsize="end" android:textSize="13sp" android:textColor="#FF102000" android:fontFamily="@font/epilogue" />
    <TextView android:id="@+id/ln_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="6dp" android:paddingEnd="6dp" android:textSize="17sp" android:textColor="#FF102000" android:fontFamily="@font/epilogue" />
    <TextView android:id="@+id/ln_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/ln_minute_pill"
        android:paddingStart="6dp" android:paddingEnd="6dp" android:textSize="10sp" android:textColor="#FFFFFFFF" android:fontFamily="@font/epilogue" />
    <TextView android:id="@+id/ln_away" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:gravity="end" android:maxLines="1" android:ellipsize="end" android:textSize="13sp" android:textColor="#FF102000" android:fontFamily="@font/epilogue" />
    <FrameLayout android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/ln_crest_plate">
            <ImageView android:id="@+id/ln_away_logo" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="3dp" android:scaleType="fitCenter" />
        </FrameLayout>
</LinearLayout>
