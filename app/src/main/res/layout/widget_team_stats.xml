<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/mw_card" android:orientation="horizontal" android:padding="14dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.9" android:gravity="center" android:orientation="vertical">
        <ImageView android:id="@+id/ts_logo" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_crest_placeholder" android:scaleType="fitCenter" />
        <TextView android:id="@+id/ts_team" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Real Madrid" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:fontFamily="@font/epilogue" android:layout_marginTop="8dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.4" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical|end" android:orientation="horizontal">
            <ImageView android:id="@+id/ts_league_logo" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_crest_placeholder" android:scaleType="fitCenter" />
            <TextView android:id="@+id/ts_league" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LALIGA" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFF4D4D" android:fontFamily="@font/epilogue" android:layout_marginStart="4dp" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/ts_season" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2025/26 ⌄" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:fontFamily="@font/epilogue" android:background="@drawable/mw_chip" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/mw_stat_tile" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_mw_matches" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical">
                    <TextView android:id="@+id/ts_matches" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="54" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:fontFamily="@font/epilogue" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Matches" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:textColor="#FF8E8E93" android:fontFamily="@font/epilogue" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/mw_stat_tile" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_stat_ball" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical">
                    <TextView android:id="@+id/ts_goals" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="54" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:fontFamily="@font/epilogue" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Goals" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:textColor="#FF8E8E93" android:fontFamily="@font/epilogue" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/mw_stat_tile" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
                <ImageView android:layout_width="12dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:src="@drawable/mw_yellow" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical">
                    <TextView android:id="@+id/ts_yellow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="54" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:fontFamily="@font/epilogue" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yellow cards" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:textColor="#FF8E8E93" android:fontFamily="@font/epilogue" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/mw_stat_tile" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
                <ImageView android:layout_width="12dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:src="@drawable/mw_red" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical">
                    <TextView android:id="@+id/ts_red" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="54" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:fontFamily="@font/epilogue" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Red cards" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:textColor="#FF8E8E93" android:fontFamily="@font/epilogue" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
