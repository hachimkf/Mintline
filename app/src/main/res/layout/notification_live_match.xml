<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/ln_card" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/ln_league" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
        android:background="@drawable/ln_league_pill" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="2dp" android:paddingBottom="2dp"
        android:maxLines="1" android:textSize="11sp" android:textColor="#FF102000" android:fontFamily="@font/epilogue" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/ln_crest_plate">
            <ImageView android:id="@+id/ln_home_logo" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="6dp" android:scaleType="fitCenter" />
        </FrameLayout>
            <TextView android:id="@+id/ln_home" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:textColor="#FF102000" android:fontFamily="@font/epilogue" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="6dp">
            <TextView android:id="@+id/ln_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="28sp" android:textColor="#FF102000" android:fontFamily="@font/epilogue" />
            <TextView android:id="@+id/ln_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/ln_minute_pill"
                android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:textSize="11sp" android:textColor="#FFFFFFFF" android:fontFamily="@font/epilogue" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/ln_crest_plate">
            <ImageView android:id="@+id/ln_away_logo" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="6dp" android:scaleType="fitCenter" />
        </FrameLayout>
            <TextView android:id="@+id/ln_away" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:textColor="#FF102000" android:fontFamily="@font/epilogue" />
        </LinearLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/ln_progress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="10dp" android:max="90" android:progressDrawable="@drawable/ln_progress" />
</LinearLayout>
