<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/mw_card" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/ft_league_logo" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_crest_placeholder" android:scaleType="fitCenter" />
        <TextView android:id="@+id/ft_league" android:layout_width="0dp" android:layout_height="wrap_content" android:text="LALIGA" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFF4D4D" android:fontFamily="@font/epilogue" android:layout_marginStart="5dp" android:layout_weight="1"/>
        <TextView android:id="@+id/ft_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11.05" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textColor="#FF8E8E93" android:fontFamily="@font/epilogue" />
    </LinearLayout>
    <TextView android:id="@+id/ft_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Full Time" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:fontFamily="@font/epilogue" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:orientation="horizontal">
        <ImageView android:id="@+id/ft_home_logo" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_crest_placeholder" android:scaleType="fitCenter" />
        <TextView android:id="@+id/ft_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 - 2" android:textSize="24sp" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFFFF" android:fontFamily="@font/epilogue" android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>
        <ImageView android:id="@+id/ft_away_logo" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_crest_placeholder" android:scaleType="fitCenter" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/ft_scorers" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:maxLines="3" android:text="Rashford 9'" android:textSize="10sp" android:textColor="#FF8E8E93" android:fontFamily="@font/epilogue" />

</LinearLayout>
