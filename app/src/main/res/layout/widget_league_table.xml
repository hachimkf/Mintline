            <TextView android:id="@+id/lt_r3_p" android:layout_width="26dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="@color/mw_muted" /><TextView android:id="@+id/lt_r3_w" android:layout_width="26dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="@color/mw_muted" /><TextView android:id="@+id/lt_r3_d" android:layout_width="26dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="@color/mw_muted" /><TextView android:id="@+id/lt_r3_l" android:layout_width="26dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="@color/mw_muted" /><TextView android:id="@+id/lt_r3_pts" android:layout_width="30dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="13sp" android:textColor="@color/mw_text" />
        </LinearLayout>
        <LinearLayout android:id="@+id/lt_row4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/lt_r4" android:layout_width="18dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="@color/mw_text" />
            <ImageView android:id="@+id/lt_r4_logo" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="4dp" />
            <TextView android:id="@+id/lt_r4_team" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:maxLines="1" android:ellipsize="end" android:textSize="13sp" android:textColor="@color/mw_text" />
            <TextView android:id="@+id/lt_r4_p" android:layout_width="26dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="@color/mw_muted" /><TextView android:id="@+id/lt_r4_w" android:layout_width="26dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="@color/mw_muted" /><TextView android:id="@+id/lt_r4_d" android:layout_width="26dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="@color/mw_muted" /><TextView android:id="@+id/lt_r4_l" android:layout_width="26dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="@color/mw_muted" /><TextView android:id="@+id/lt_r4_pts" android:layout_width="30dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="13sp" android:textColor="@color/mw_text" />
        </LinearLayout>
</LinearLayout>
