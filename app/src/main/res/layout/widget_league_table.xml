    </LinearLayout>
        <LinearLayout android:id="@+id/lt_row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/lt_r1" android:layout_width="18dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="@color/mw_text" />
            <ImageView android:id="@+id/lt_r1_logo" android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="4dp" />
