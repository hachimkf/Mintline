            <TextView android:id="@+id/lt_r1_p" android:layout_width="26dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="@color/mw_muted" /><TextView android:id="@+id/lt_r1_w" android:layout_width="26dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="@color/mw_muted" /><TextView android:id="@+id/lt_r1_d" android:layout_width="26dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="@color/mw_muted" /><TextView android:id="@+id/lt_r1_l" android:layout_width="26dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="@color/mw_muted" /><TextView android:id="@+id/lt_r1_pts" android:layout_width="30dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="13sp" android:textColor="@color/mw_text" />
        </LinearLayout>
        <LinearLayout android:id="@+id/lt_row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
